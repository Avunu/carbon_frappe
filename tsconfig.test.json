{
	// The node:test unit tests. They import the browser modules directly —
	// which is why those carry `.ts` on their relative imports — and stub the
	// handful of desk globals the pure functions read at call time.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "frappe-types/global"],
		"allowImportingTsExtensions": true
	},
	// scripts/lib is the pure half of the build scripts (icon codegen, the drift
	// audits' scanners); the tests import it directly. The scripts project owns
	// it too — a module may belong to both.
	"include": ["test/**/*.ts", "carbon_frappe/public/js/**/*.ts", "scripts/lib/**/*.ts"],
	"exclude": ["node_modules", "carbon_frappe/public/dist"]
}